<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/ios_out"
    android:zAdjustment="top">
    <alpha android:duration="240" android:fromAlpha="0" android:toAlpha="1" />
    <scale
        android:duration="260"
        android:fromXScale="0.97"
        android:fromYScale="0.97"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1"
        android:toYScale="1" />
</set>
