<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="installer"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/pk_title"
        android:shortcutLongLabel="@string/pk_title">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.fileman.app.InstallerActivity"
            android:targetPackage="app.fileman.mgr" />
    </shortcut>
    <shortcut
        android:shortcutId="found_packages"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/pk_found"
        android:shortcutLongLabel="@string/pk_found">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.fileman.app.InstallerActivity"
            android:targetPackage="app.fileman.mgr">
            <extra
                android:name="found"
                android:value="true" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/fm_search"
        android:shortcutLongLabel="@string/fm_search">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.fileman.app.FileManagerActivity"
            android:targetPackage="app.fileman.mgr">
            <extra
                android:name="search"
                android:value="true" />
        </intent>
    </shortcut>
</shortcuts>
