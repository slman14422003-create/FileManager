<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="?attr/cSurface"
                android:startColor="?attr/cAccentSoft"
                android:type="linear" />
            <stroke android:width="1dp" android:color="?attr/cStrokeSoft" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</ripple>
