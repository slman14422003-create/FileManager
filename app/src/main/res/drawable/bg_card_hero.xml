<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="220">
    <item android:state_pressed="true">
        <layer-list>
<item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="?attr/cSurface"
                android:startColor="?attr/cAccentSoft"
                android:type="linear" />
            <stroke android:width="1dp" android:color="?attr/cStrokeSoft" />
            <corners android:radius="24dp" />
        </shape>
    </item>
<item>
        <shape android:shape="rectangle">
            <solid android:color="@color/row_press" />
            <corners android:radius="24dp" />
        </shape>
    </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
<item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="?attr/cSurface"
                android:startColor="?attr/cAccentSoft"
                android:type="linear" />
            <stroke android:width="1dp" android:color="?attr/cStrokeSoft" />
            <corners android:radius="24dp" />
        </shape>
    </item>
        </layer-list>
    </item>
</selector>
