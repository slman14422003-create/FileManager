<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Layout language (see LAYOUT.md). Three width classes, chosen by Android from the real window width,
        so phones, foldables, tablets, landscape and split-screen all pick the right set automatically:
          compact  < 600dp   (this file)         phones in portrait
          medium   >= 600dp  (values-w600dp)     large phones in landscape, small tablets, unfolded foldables
          expanded >= 840dp  (values-w840dp)     tablets, desktop-like windows
    -->
    <!-- space between the screen edge and cards / rows -->
    <dimen name="gutter">14dp</dimen>
    <!-- widest the page content may grow before it is centred with margins on both sides (0 = no limit) -->
    <dimen name="content_max_width">0dp</dimen>
    <!-- widest the floating bottom bar may grow -->
    <dimen name="nav_max_width">0dp</dimen>
    <!-- home screen grid cell -->
    <dimen name="tile_box">80dp</dimen>
    <dimen name="tile_icon">38dp</dimen>
    <!-- narrowest a home grid cell may get; the column count is derived from it -->
    <dimen name="tile_min_cell">104dp</dimen>

    <!-- share send/receive: QR code card, its radar-pulse ring, and the receive-side transfer icon -->
    <dimen name="share_qr_max">320dp</dimen>
    <dimen name="share_pulse_margin">70dp</dimen>
    <dimen name="share_dl_pulse">96dp</dimen>
    <dimen name="share_dl_icon">28dp</dimen>

    <!-- dialog width as a share of the window -->
    <fraction name="dlg_min_minor">80%</fraction>
    <fraction name="dlg_min_major">54%</fraction>
</resources>
